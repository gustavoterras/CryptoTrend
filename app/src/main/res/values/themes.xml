<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CryptoTrend" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.CryptoTrend.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_brand_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.CryptoTrend</item>
    </style>
</resources>