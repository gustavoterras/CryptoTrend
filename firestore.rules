rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string &&
             id.size() >= 1 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_.\\-]+$');
    }

    function isValidFavoriteCoin(data, userId, coinId) {
      return data.userId is string &&
             data.userId == userId &&
             data.coinId is string &&
             data.coinId == coinId &&
             isValidId(data.coinId) &&
             data.symbol is string &&
             data.symbol.size() <= 32 &&
             data.name is string &&
             data.name.size() <= 128 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/favorites/{coinId} {
      allow get: if isOwner(userId) && isValidId(coinId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(coinId) &&
                       incoming().keys().hasAll(['userId', 'coinId', 'symbol', 'name', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'coinId', 'symbol', 'name', 'createdAt', 'updatedAt']) &&
                       isValidFavoriteCoin(incoming(), userId, coinId);

      allow update: if isOwner(userId) &&
                       isValidId(coinId) &&
                       isValidFavoriteCoin(incoming(), userId, coinId) &&
                       incoming().userId == existing().userId &&
                       incoming().coinId == existing().coinId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['symbol', 'name', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(coinId);
    }
  }
}
